<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coworking_addon_tree" model="ir.ui.view">
        <field name="name">coworking.addon.tree</field>
        <field name="model">coworking.addon</field>
        <field name="arch" type="xml">
            <list string="Servicios Adicionales">
                <field name="icon"/>
                <field name="name"/>
                <field name="billing_unit"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_coworking_addon_form" model="ir.ui.view">
        <field name="name">coworking.addon.form</field>
        <field name="model">coworking.addon</field>
        <field name="arch" type="xml">
            <form string="Servicio Adicional">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="icon"/>
                            <field name="billing_unit"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Detalle del servicio..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_coworking_addon" model="ir.actions.act_window">
        <field name="name">Servicios Adicionales (Upselling)</field>
        <field name="res_model">coworking.addon</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
