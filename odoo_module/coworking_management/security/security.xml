<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_coworking_category" model="ir.module.category">
            <field name="name">Coworking &amp; Espacios</field>
            <field name="description">Gestión de reservas de espacios, validación SINPE y calendarios</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_coworking_user" model="res.groups">
            <field name="name">Operador de Reservas</field>
            <field name="category_id" ref="module_coworking_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_coworking_manager" model="res.groups">
            <field name="name">Administrador / Gerente</field>
            <field name="category_id" ref="module_coworking_category"/>
            <field name="implied_ids" eval="[(4, ref('group_coworking_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
