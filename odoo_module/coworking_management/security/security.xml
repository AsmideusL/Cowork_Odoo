<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: los grupos ya no usan category_id/users.
         Se agrupan mediante res.groups.privilege (privilege_id) y los usuarios van en user_ids. -->
    <record id="module_coworking_category" model="ir.module.category">
        <field name="name">Coworking &amp; Espacios</field>
        <field name="description">Gestión de reservas de espacios, validación SINPE y calendarios</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_coworking" model="res.groups.privilege">
        <field name="name">Coworking</field>
        <field name="category_id" ref="module_coworking_category"/>
        <field name="sequence">25</field>
    </record>

    <record id="group_coworking_user" model="res.groups">
        <field name="name">Operador de Reservas</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_coworking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_coworking_manager" model="res.groups">
        <field name="name">Administrador / Gerente</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_coworking"/>
        <field name="implied_ids" eval="[(4, ref('group_coworking_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
